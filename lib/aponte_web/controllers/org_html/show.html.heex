<Layouts.app flash={@flash} org={@org} current_path={@conn.request_path}>
  <div class="vitrine">
    <section :if={@edition} class="vitrine-edition">
      <.org_logo org={@org} edition={@edition} class="vitrine-edition-logo" />

      <div class="vitrine-edition-body stack-4">
        <div class="stack-2">
          <p class="vitrine-eyebrow">{"#{@org.name} ##{@edition.number}"}</p>
          <h1
            :if={
              @edition.name not in [
                "#{@org.name} ##{@edition.number}",
                "#{@org.name} #{@edition.number}"
              ]
            }
            class="vitrine-edition-title"
          >
            {@edition.name}
          </h1>
        </div>

        <p class="date-duo">
          <span>{edition_time(@edition.starts_at)}</span>
          <span>{edition_day(@edition.starts_at)}</span>
        </p>

        <% lineup = lineup_lines(@edition.lineup) %>
        <section :if={lineup != []} class="stack-1">
          <h2 class="section-label">Quem toca</h2>
          <ul class="lineup stack-1">
            <li :for={name <- lineup} class="text-base">{name}</li>
          </ul>
        </section>

        <section :if={@edition.venue} class="stack-1">
          <h2 class="section-label">Onde</h2>
          <p class="text-base">{@edition.venue}</p>
          <a
            :if={@edition.venue_address}
            href={"https://www.google.com/maps/search/?api=1&query=#{URI.encode_www_form("#{@edition.venue} #{@edition.venue_address}")}"}
            target="_blank"
            rel="noopener"
            class="text-xs text-dim"
          >
            {@edition.venue_address}
          </a>
        </section>

        <%!-- docked CTA: desktop only; on mobile the floating CTA covers it --%>
        <a href={~p"/#{@org.slug}/comprar"} class="btn btn--blob vitrine-cta-docked">
          Garantir ingresso →
        </a>
      </div>
    </section>

    <section :if={is_nil(@edition)} class="vitrine-edition">
      <.org_logo org={@org} class="vitrine-edition-logo" />
      <div class="vitrine-edition-body stack-4">
        <h1 class="sr-only">{@org.name}</h1>
        <p class="text-base text-dim">Próxima edição em breve.</p>

        <%!-- empty vitrine: tease the gallery (thumbs link to /galeria) and
             the org's instagram; the avisos CTA stays the primary action --%>
        <a
          :if={@gallery_tease != []}
          href={~p"/#{@org.slug}/galeria"}
          class="vitrine-gallery-tease"
          aria-label={"Galeria de #{@org.name}"}
        >
          <img :for={img <- @gallery_tease} src={image_url(@org, img.thumb_path)} alt="" />
        </a>

        <a href={~p"/#{@org.slug}/sobre" <> "#avisos"} class="btn btn--blob btn--block">
          Quero ser avisade
        </a>
        <a
          :if={@org.instagram}
          href={AponteWeb.Instagram.profile_url(@org.instagram)}
          target="_blank"
          rel="noopener"
          class="text-sm"
        >
          {instagram_handle(@org.instagram)}
        </a>
      </div>
    </section>

    <%!-- editions list: the current published one links to the compra flow;
         the rest are plain text (no per-edition public pages in v1). --%>
    <div
      :if={@upcoming_editions != [] or @past_editions != []}
      class="vitrine-editions stack-5"
    >
      <section :if={@upcoming_editions != []} class="stack-2">
        <h2 class="section-label">Próximas edições</h2>
        <ul class="inset-list">
          <li :for={ed <- @upcoming_editions}>
            <a
              :if={@edition && ed.id == @edition.id}
              href={~p"/#{@org.slug}/comprar"}
              class="inset-row"
            >
              <span class="text-base">{ed.name}</span>
              <span class="row gap-2 align-center">
                <span class="text-xs text-dim">{edition_day(ed.starts_at)}</span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="inset-chev"
                  aria-hidden="true"
                >
                  <path d="m9 5 7 7-7 7" />
                </svg>
              </span>
            </a>
            <p :if={is_nil(@edition) or ed.id != @edition.id} class="inset-row inset-row--static">
              <span class="text-base text-dim">{ed.name}</span>
              <span class="text-xs text-dim">{edition_day(ed.starts_at)}</span>
            </p>
          </li>
        </ul>
      </section>

      <section :if={@past_editions != []} class="stack-2">
        <h2 class="section-label">Edições passadas</h2>
        <ul class="inset-list">
          <li :for={ed <- @past_editions} class="inset-row inset-row--static">
            <span class="text-base text-dim">{ed.name}</span>
            <span class="text-xs text-dim">{edition_day(ed.starts_at)}</span>
          </li>
        </ul>
      </section>
    </div>
  </div>

  <.floating_cta :if={@edition} href={~p"/#{@org.slug}/comprar"} label="Garantir ingresso" />
</Layouts.app>
