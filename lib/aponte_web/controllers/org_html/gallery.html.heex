<Layouts.app flash={@flash} org={@org} current_path={@conn.request_path}>
  <section class="stack-3">
    <h1 class="text-xl">Galeria</h1>

    <ul :if={@images != []} class="gallery-page-grid" data-gallery>
      <li :for={{img, index} <- Enum.with_index(@images, 1)}>
        <%!-- href stays for long-press save / open-in-new-tab; lightbox.js
             intercepts the tap and shows the full image in-app. --%>
        <a
          href={image_url(@org, img.path)}
          data-lightbox
          aria-label={"Foto #{index} da galeria de #{@org.name}"}
        >
          <img src={image_url(@org, img.thumb_path)} alt="" loading="lazy" />
        </a>
      </li>
    </ul>

    <p :if={@images == []} class="text-sm text-dim">Nenhuma foto por aqui ainda.</p>
  </section>
</Layouts.app>
