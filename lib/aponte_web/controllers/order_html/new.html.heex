<Layouts.app flash={@flash} org={@org} current_path={@conn.request_path}>
  <.form
    :let={f}
    for={@changeset}
    action={~p"/#{@org.slug}/comprar"}
    class="stack-5"
    id="order-form"
  >
    <input type="hidden" name="order[client_endpoint]" data-client-endpoint />

    <header class="stack-1">
      <p class="eyebrow">{@edition.name}</p>
      <h1 class="text-xl">Comprar</h1>
      <p class="text-sm text-dim">Escolha as quantidades e preencha seus dados.</p>
    </header>

    <div :if={@form_error} class="alert alert--error" role="alert">
      <p class="text-sm">{@form_error}</p>
    </div>

    <div
      :if={@changeset.action && not Enum.empty?(@changeset.errors)}
      class="alert alert--error"
      role="alert"
    >
      <p class="text-sm">Não foi possível registrar o pedido. Confira os campos destacados.</p>
    </div>

    <div class="buy-grid">
      <div class="stack-5">
        <.form_section title="Ingressos">
          <p :if={@lots == []} class="text-sm text-dim">
            Nenhum lote à venda agora. Fica de olho que abre logo.
          </p>

          <ul :if={@lots != []} class="stack-3">
            <.lot_row lots={@lots} items={@items} />
          </ul>
        </.form_section>

        <.form_section :if={@merch != []} title="Leve também">
          <ul class="stack-3">
            <.merch_row merch={@merch} items={@items} />
          </ul>
        </.form_section>
      </div>

      <.form_section
        :if={@lots != [] or @merch != []}
        title="Seus dados"
        class="buy-grid-side"
      >
        <.input field={f[:customer_name]} label="Nome" required autocomplete="name" />

        <div class="field-group stack-2">
          <span class="field-label">Como a gente te acha</span>

          <.input
            field={f[:customer_instagram]}
            type="text"
            label="Instagram (sem o @)"
            inputmode="text"
            autocomplete="off"
            placeholder="seu.usuario"
          />

          <.input
            field={f[:customer_phone]}
            type="tel"
            label="Telefone"
            inputmode="numeric"
            autocomplete="tel"
            placeholder="22 99999-8888"
          />

          <p class="text-xs text-dim">
            Instagram ou telefone, pelo menos um. É por aí que a {@org.name} te chama sobre seu ingresso.
          </p>
        </div>

        <.input
          field={f[:coupon_code]}
          type="text"
          label="Cupom (opcional)"
          autocomplete="off"
          placeholder="Ex: APO-7K9Q"
        />

        <label class="field field--inline">
          <input type="checkbox" id="remember-me" data-remember class="checkbox" />
          <span class="field-label">Lembrar meus dados neste aparelho</span>
        </label>

        <button type="button" class="btn btn--ghost btn--block" data-clear-storage>
          Limpar meus dados deste dispositivo
        </button>
      </.form_section>
    </div>

    <.form_bar :if={@lots != [] or @merch != []}>
      <p class="text-xs text-dim gate-hint" data-gate-hint hidden></p>
      <.button type="submit" variant={:primary} class="btn--block btn--blob">
        Ir pro PIX
      </.button>
    </.form_bar>
  </.form>
</Layouts.app>
