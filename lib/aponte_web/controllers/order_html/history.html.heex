<Layouts.app flash={@flash} org={@org} current_path={@conn.request_path}>
  <section class="stack-5">
    <header class="stack-1">
      <h1 class="text-xl">Meus ingressos</h1>
      <p class="text-sm text-dim">
        Compras feitas neste aparelho. Toque pra ver status, PIX e QR.
      </p>
    </header>

    <%!-- phase 6: orders.js builds /compra/ links from data-org-slug --%>
    <div data-order-history data-org-slug={@org.slug}></div>

    <.form :let={_f} for={%{}} action={~p"/#{@org.slug}/meus-ingressos"} class="stack-3">
      <header class="stack-1">
        <h2 class="section-label">Achar um pedido</h2>
        <p class="text-xs text-dim">
          Perdeu o link do pedido? Busca pelo telefone e o código do pedido.
        </p>
      </header>

      <.field for="lookup-phone" label="Telefone (DDD + número)">
        <input
          id="lookup-phone"
          type="tel"
          name="phone"
          required
          inputmode="numeric"
          placeholder="22999998888"
          class="input text-mono"
          autocomplete="off"
        />
      </.field>

      <.field
        for="lookup-code"
        label="Código ou link do pedido"
        hint="Tá no link que você recebeu, depois de /compra/."
      >
        <input
          id="lookup-code"
          type="text"
          name="code"
          required
          placeholder="código ou link do pedido"
          class="input text-mono"
          autocapitalize="off"
          autocomplete="off"
          spellcheck="false"
        />
      </.field>

      <.button type="submit" variant={:primary} class="btn--block">Buscar pedido</.button>
    </.form>

    <form class="stack-3" data-order-import data-org-slug={@org.slug}>
      <header class="stack-1">
        <h2 class="section-label">Salvar um link</h2>
        <p class="text-xs text-dim">
          Comprou pelo Instagram ou abriu o link em outro app? Cole aqui o link
          do seu pedido pra salvar o pedido neste aparelho.
        </p>
      </header>

      <.field for="order-import-input" label="Link do pedido">
        <input
          id="order-import-input"
          type="text"
          inputmode="url"
          placeholder="https://…/compra/…"
          class="input text-mono"
          autocapitalize="off"
          autocomplete="off"
          spellcheck="false"
        />
      </.field>

      <button type="submit" class="btn btn--ghost btn--block">Salvar pedido</button>
    </form>

    <a href={~p"/#{@org.slug}"} class="btn btn--ghost btn--block">Voltar</a>
  </section>
</Layouts.app>
