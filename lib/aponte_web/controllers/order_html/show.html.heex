<Layouts.app flash={@flash} org={@org} current_path={@conn.request_path}>
  <div
    hidden
    data-order-record
    data-id={@order.id}
    data-label={order_label(@order)}
    data-org-slug={@org.slug}
  >
  </div>
  <%!-- Pending: orders.js polls and reloads on confirm; no blind meta-refresh. --%>
  <div
    :if={@order.status == :pending}
    hidden
    data-order-watch
    data-order-status={@order.status}
    data-url={@conn.request_path}
  >
  </div>

  <section class="stack-5">
    <header class="stack-2">
      <p class="eyebrow">{if @edition, do: @edition.name, else: @org.name}</p>
      <h1 class="text-xl">Pedido</h1>
      <div class="row gap-3 align-center">
        <.status_badge status={@order.status} />
        <p class="text-xs text-dim">{status_message(@order.status)}</p>
        <p :if={@order.status == :pending} data-order-updating hidden class="text-xs text-dim">
          Atualizando...
        </p>
      </div>
    </header>

    <ul class="inset-list">
      <li :for={item <- @order.items} class="inset-row inset-row--static">
        <span class="text-sm">{item.quantity}× {Aponte.Tickets.OrderItem.line_name(item)}</span>
        <span class="text-mono text-sm">{money(item.unit_price_cents * item.quantity)}</span>
      </li>
      <li :if={@order.discount_cents > 0} class="inset-row inset-row--static">
        <span class="text-sm text-muted">Cupom {@order.coupon_code}</span>
        <span class="text-mono text-sm text-muted">- {money(@order.discount_cents)}</span>
      </li>
      <li class="inset-row inset-row--static">
        <span class="text-sm text-muted">Total</span>
        <span class="text-mono text-lg">{money(@order.total_cents)}</span>
      </li>
    </ul>

    <section
      :if={@order.status == :confirmed and @order.tickets != []}
      class="stack-3"
    >
      <header class="stack-1">
        <h2 class="section-label">Seus ingressos ({length(@order.tickets)})</h2>
        <p class="text-xs text-dim">Mostre o QR na porta. Cada ingresso entra uma vez.</p>
      </header>

      <ul class="stack-3">
        <li :for={ticket <- @order.tickets} class="ticket-card">
          <div class="qr-frame" aria-label="qr code do ingresso">
            {Phoenix.HTML.raw(ticket_qr(ticket))}
          </div>
          <span class="text-mono text-lg">{ticket_display_code(ticket)}</span>
        </li>
      </ul>
    </section>

    <section :if={@order.status == :confirmed and @order.merch_units != []} class="stack-3">
      <header class="stack-1">
        <h2 class="section-label">Seus produtos ({length(@order.merch_units)})</h2>
        <p class="text-xs text-dim">
          Mostre o QR no balcão pra retirar. Cada código retira uma vez.
        </p>
      </header>
      <ul class="stack-3">
        <li :for={unit <- @order.merch_units} class="ticket-card">
          <div class="qr-frame" aria-label="qr code do produto">
            {Phoenix.HTML.raw(merch_qr(unit))}
          </div>
          <span class="text-base">{unit.merch_item_name_snapshot}</span>
          <span class="text-mono text-lg">{merch_display_code(unit)}</span>
        </li>
      </ul>
    </section>

    <section :if={@earned != []} class="stack-2 alert alert--info">
      <h2 class="section-label">Cupons na conta</h2>
      <ul class="stack-1">
        <li :for={c <- @earned} class="row space-between text-sm">
          <span class="text-mono">{c.code}</span>
          <span class="text-xs text-dim">{coupon_label(c)}</span>
        </li>
      </ul>
      <p class="text-xs text-dim">Use na sua próxima compra.</p>
    </section>

    <section :if={@pix} class="stack-3 pix-block">
      <h2 class="section-label">PIX</h2>

      <ol class="pix-steps stack-4">
        <li class="pix-step stack-2">
          <span class="pix-step-label">1. Copia o código ou aponta a câmera pro QR</span>
          <div class="qr-frame" aria-label="qr code pix">
            {Phoenix.HTML.raw(@pix.svg)}
          </div>
          <div class="stack-2">
            <span class="text-xs text-dim">Copia e cola</span>
            <code class="pix-copy text-mono text-xs" id="pix-copy" data-pix-copy>{@pix.emv}</code>
            <button type="button" class="btn btn--accent btn--block" data-copy-target="#pix-copy">
              Copiar código PIX
            </button>
          </div>
        </li>

        <li class="pix-step stack-2">
          <span class="pix-step-label">2. Paga no app do seu banco</span>
          <p class="text-sm">{money(@order.total_cents)} na chave pix de {@org.name}.</p>
          <div class="stack-2">
            <code class="pix-copy text-mono text-xs" id="pix-key">{@org.pix_key}</code>
            <button type="button" class="btn btn--ghost btn--block" data-copy-target="#pix-key">
              Copiar chave
            </button>
          </div>
        </li>

        <li class="pix-step stack-2">
          <span class="pix-step-label">3. Espera a confirmação</span>
          <p class="text-sm">
            A {@org.name} confirma manualmente e seus ingressos aparecem aqui. Pagou e demorou? Chama no Instagram.
          </p>
          <a
            :if={AponteWeb.Instagram.dm_url(@org.instagram)}
            href={AponteWeb.Instagram.dm_url(@org.instagram)}
            class="btn btn--ghost btn--block"
          >
            Chamar no Instagram
          </a>
        </li>
      </ol>
    </section>

    <section
      :if={@order.status == :pending and is_nil(@pix)}
      class="stack-3 alert alert--info"
    >
      <h2 class="section-label">PIX</h2>
      <p class="text-sm">
        A {@org.name} ainda não cadastrou a chave PIX. Chama no Instagram pra combinar o pagamento do seu pedido.
      </p>
      <a
        :if={AponteWeb.Instagram.dm_url(@org.instagram)}
        href={AponteWeb.Instagram.dm_url(@org.instagram)}
        class="btn btn--primary btn--block"
      >
        Chamar no Instagram
      </a>
    </section>

    <section :if={@order.status in [:cancelled, :expired]} class="stack-3">
      <p class="text-sm">
        {if @order.status == :cancelled,
          do: "Esse pedido foi cancelado.",
          else: "Esse pedido expirou."} Se você pagou, fala com a {@org.name}.
      </p>
      <a
        :if={AponteWeb.Instagram.dm_url(@org.instagram)}
        href={AponteWeb.Instagram.dm_url(@org.instagram)}
        class="btn btn--ghost btn--block"
      >
        Chamar no Instagram
      </a>
      <a :if={@can_rebuy} href={~p"/#{@org.slug}/comprar"} class="btn btn--primary btn--block">
        Comprar de novo
      </a>
    </section>

    <div
      :if={@order.status == :pending}
      data-push-prompt
      data-push-vapid-url={~p"/#{@org.slug}/push/vapid-key"}
      data-push-sub-url={~p"/#{@org.slug}/push/subscribe"}
    >
    </div>

    <a href={~p"/#{@org.slug}"} class="btn btn--ghost btn--block">Voltar</a>
  </section>
</Layouts.app>
