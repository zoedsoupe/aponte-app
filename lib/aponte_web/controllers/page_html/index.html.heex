<Layouts.app flash={@flash}>
  <section class="stack-6">
    <header class="stack-3">
      <img src={~p"/images/aponte-logo.jpg"} alt="Aponte" class="aponte-logo aponte-logo--hero" />
      <p class="text-base text-dim">o que tá rolando em Campos</p>
    </header>

    <ul :if={@orgs != []} class="stack-3">
      <li :for={{org, edition} <- @orgs}>
        <a
          href={~p"/#{org.slug}"}
          class="card card--link stack-1"
          style={"--accent: #{org.accent_color}"}
        >
          <span class="text-lg">{org.name}</span>
          <span :if={edition} class="text-xs text-dim text-mono">
            {edition.name} - {edition_day(edition.starts_at)} {edition_time(edition.starts_at)}
          </span>
          <span :if={is_nil(edition)} class="text-xs text-dim">edição em breve</span>
        </a>
      </li>
    </ul>

    <p :if={@orgs == []} class="text-sm text-dim">Nenhum rolê no ar ainda. Volta logo.</p>
  </section>
</Layouts.app>
